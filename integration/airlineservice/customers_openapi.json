{
  "openapi" : "3.0.1",
  "info" : {
    "title" : "Customers",
    "version" : "0.1.0"
  },
  "servers" : [ {
    "url" : "{server}:{port}/customers",
    "variables" : {
      "server" : {
        "default" : "http://localhost"
      },
      "port" : {
        "default" : "9091"
      }
    }
  } ],
  "paths" : {
    "/{customerId}" : {
      "get" : {
        "operationId" : "getCustomerid",
        "parameters" : [ {
          "name" : "customerId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Ok",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Customer"
                }
              }
            }
          },
          "500" : {
            "description" : "InternalServerError"
          },
          "404" : {
            "description" : "NotFound"
          },
          "400" : {
            "description" : "BadRequest",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorPayload"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "Customer" : {
        "required" : [ "customerId", "email", "firstName", "lastName", "phoneNumber" ],
        "type" : "object",
        "properties" : {
          "customerId" : {
            "type" : "string"
          },
          "firstName" : {
            "type" : "string"
          },
          "lastName" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          },
          "phoneNumber" : {
            "type" : "string"
          },
          "loyaltyTier" : {
            "type" : "string"
          }
        },
        "additionalProperties" : false
      },
      "ErrorPayload" : {
        "required" : [ "message", "method", "path", "reason", "status", "timestamp" ],
        "type" : "object",
        "properties" : {
          "timestamp" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer",
            "format" : "int64"
          },
          "reason" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          },
          "path" : {
            "type" : "string"
          },
          "method" : {
            "type" : "string"
          }
        }
      }
    }
  }
}