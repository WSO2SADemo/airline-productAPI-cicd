{
  "openapi" : "3.0.1",
  "info" : {
    "title" : "Notifications",
    "version" : "0.1.0"
  },
  "servers" : [ {
    "url" : "{server}:{port}/notifications",
    "variables" : {
      "server" : {
        "default" : "http://localhost"
      },
      "port" : {
        "default" : "9091"
      }
    }
  } ],
  "paths" : {
    "/" : {
      "post" : {
        "operationId" : "post",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/NotificationRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "Ok"
          },
          "400" : {
            "description" : "BadRequest",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorPayload"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "ErrorPayload" : {
        "required" : [ "message", "method", "path", "reason", "status", "timestamp" ],
        "type" : "object",
        "properties" : {
          "timestamp" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer",
            "format" : "int64"
          },
          "reason" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          },
          "path" : {
            "type" : "string"
          },
          "method" : {
            "type" : "string"
          }
        }
      },
      "NotificationRequest" : {
        "required" : [ "customerId", "email", "message", "subject" ],
        "type" : "object",
        "properties" : {
          "customerId" : {
            "type" : "string"
          },
          "email" : {
            "type" : "string"
          },
          "subject" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          }
        },
        "additionalProperties" : false
      }
    }
  }
}