{
  "openapi" : "3.0.1",
  "info" : {
    "title" : "Flights",
    "version" : "0.1.0"
  },
  "servers" : [ {
    "url" : "{server}:{port}/flights",
    "variables" : {
      "server" : {
        "default" : "http://localhost"
      },
      "port" : {
        "default" : "9091"
      }
    }
  } ],
  "paths" : {
    "/" : {
      "get" : {
        "operationId" : "get",
        "parameters" : [ {
          "name" : "origin",
          "in" : "query",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "destination",
          "in" : "query",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Ok",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/Flight"
                  }
                }
              }
            }
          },
          "400" : {
            "description" : "BadRequest",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorPayload"
                }
              }
            }
          }
        }
      }
    },
    "/{flightNumber}" : {
      "get" : {
        "operationId" : "getFlightnumber",
        "parameters" : [ {
          "name" : "flightNumber",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Ok",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Flight"
                }
              }
            }
          },
          "404" : {
            "description" : "NotFound"
          },
          "400" : {
            "description" : "BadRequest",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorPayload"
                }
              }
            }
          }
        }
      }
    },
    "/bookings" : {
      "post" : {
        "operationId" : "postBookings",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/BookingRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Created",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Booking"
                }
              }
            }
          },
          "400" : {
            "description" : "BadRequest",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ErrorPayload"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "Booking" : {
        "required" : [ "bookingDate", "bookingId", "customerId", "flightNumber", "seatNumber", "status", "totalAmount" ],
        "type" : "object",
        "properties" : {
          "bookingId" : {
            "type" : "string"
          },
          "customerId" : {
            "type" : "string"
          },
          "flightNumber" : {
            "type" : "string"
          },
          "seatNumber" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string"
          },
          "totalAmount" : {
            "type" : "number",
            "format" : "double"
          },
          "bookingDate" : {
            "type" : "string"
          }
        },
        "additionalProperties" : false
      },
      "BookingRequest" : {
        "required" : [ "customerId", "flightNumber", "seatPreference" ],
        "type" : "object",
        "properties" : {
          "customerId" : {
            "type" : "string"
          },
          "flightNumber" : {
            "type" : "string"
          },
          "seatPreference" : {
            "type" : "string"
          },
          "mealPreference" : {
            "type" : "string"
          }
        },
        "additionalProperties" : false
      },
      "ErrorPayload" : {
        "required" : [ "message", "method", "path", "reason", "status", "timestamp" ],
        "type" : "object",
        "properties" : {
          "timestamp" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer",
            "format" : "int64"
          },
          "reason" : {
            "type" : "string"
          },
          "message" : {
            "type" : "string"
          },
          "path" : {
            "type" : "string"
          },
          "method" : {
            "type" : "string"
          }
        }
      },
      "Flight" : {
        "required" : [ "arrivalTime", "availableSeats", "departureTime", "destination", "flightNumber", "origin", "price" ],
        "type" : "object",
        "properties" : {
          "flightNumber" : {
            "type" : "string"
          },
          "origin" : {
            "type" : "string"
          },
          "destination" : {
            "type" : "string"
          },
          "departureTime" : {
            "type" : "string"
          },
          "arrivalTime" : {
            "type" : "string"
          },
          "price" : {
            "type" : "number",
            "format" : "double"
          },
          "availableSeats" : {
            "type" : "integer",
            "format" : "int64"
          }
        },
        "additionalProperties" : false
      }
    }
  }
}